# Auto detect text files and perform LF normalization
* text=auto

# Бинарные ассеты никогда не нормализуются.
#
# `text=auto` определяет бинарность эвристикой — по нулевым байтам в начале
# файла. Для озвучки, баз и картинок это работает, но ошибка здесь молчаливая:
# git подставит CRLF внутрь файла, тот перестанет декодироваться, и заметно
# это станет только когда у игрока пропадёт звук. Перечисляем явно.
*.m4a binary
*.aac binary
*.opus binary
*.wav binary
*.mp3 binary
*.db binary
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.otf binary
*.zip binary
*.jks binary
*.keystore binary
